# Copy to .env for local development. NEVER commit real values.
# Names only: real secrets live in GitHub Environments / the host's secret manager.

NODE_ENV=development

# One of: local, test, staging, production
APP_ENV=local
APP_URL=http://localhost:3000

# Local PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/housing_dev

# Auth (server-side only). Generate a real one with: openssl rand -base64 32
AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32

# Payment partner (sandbox only outside production; no live keys in CI)
PAYMENT_PROVIDER_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Email / SMS (Phase 7)
EMAIL_API_KEY=
SMS_API_KEY=

# Object storage (Phase 7)
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Monitoring
SENTRY_DSN=

# One-off admin bootstrap, used only by `npm run db:seed`
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Set to yes for local/staging: adds sample listings, SANDBOX placeholder legal versions and,
# when APP_ENV is local or test, three demo login accounts (see README)
SEED_DEMO_DATA=

# Local/test only: where uploaded documents are written (outside public/)
LOCAL_STORAGE_DIR=.storage
