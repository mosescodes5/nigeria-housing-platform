# Copy to .env for local development. NEVER commit real values.
# Names only: real secrets live in GitHub Environments / the host's secret manager.

NODE_ENV=development
APP_ENV=local            # local | test | staging | production
APP_URL=http://localhost:3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/housing_dev

# Auth (server-side only)
AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32

# Payment partner (sandbox only outside production; no live keys in CI)
PAYMENT_PROVIDER_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Email / SMS (Phase 7)
EMAIL_API_KEY=
SMS_API_KEY=

# Object storage (Phase 7)
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Monitoring
SENTRY_DSN=

# One-off admin bootstrap, used only by `npm run db:seed` (never set in CI or production CI jobs)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Local/staging only: SEED_DEMO_DATA=yes adds demo listings and SANDBOX placeholder legal versions
SEED_DEMO_DATA=
